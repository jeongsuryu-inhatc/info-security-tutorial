# week09/local.rules — 9주차 과제 1: 커스텀 탐지 룰 3종
#
# 배치: starter/suricata/rules/local.rules 에 이어붙이거나 이 파일로 교체.
#   cp week09/local.rules starter/suricata/rules/local.rules
# 검증: bash starter/suricata/make-attack-pcap.sh  로 공격 pcap 생성 후
#   docker compose -f starter/suricata/docker-compose.yml run --rm suricata \
#     -r /pcaps/attack.pcap -l /var/log/suricata -S /rules/local.rules -k none
#
# sid 는 로컬 룰 대역(1000000+)을 쓰고, 룰마다 고유해야 한다.

# [예시-동작] 평문 /login POST 탐지 (3주차 pcap 에 매칭)
alert http any any -> any any (msg:"ShopGuard plaintext login POST"; flow:to_server; http.method; content:"POST"; http.uri; content:"/login"; classtype:policy-violation; sid:1000001; rev:1;)

# [1] SQLi 시도 — URI에서 ' OR 1=1 / UNION SELECT 패턴(대소문자·공백 유연).
#     http.uri 버퍼는 Suricata가 URL 디코드·정규화하므로 인코딩된 페이로드도 잡힌다.
alert http any any -> any any (msg:"ShopGuard SQLi attempt"; flow:to_server; http.uri; pcre:"/('|%27)?\s*(OR\s+1=1|UNION\s+SELECT)/i"; classtype:web-application-attack; sid:1000002; rev:1;)

# [2] 포트 스캔 — 5초 내 같은 출발지에서 SYN 20개 초과.
#     detection_filter 로 임계 초과분만 알림(정상 몇 개 연결은 무시).
alert tcp any any -> any any (msg:"ShopGuard portscan (SYN flood from single src)"; flags:S; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000003; rev:1;)

# [3] 로그인 브루트포스 — 30초 내 같은 출발지의 /login POST 10회 초과.
#     threshold(type threshold) 로 임계 넘는 순간 1건만 알림.
alert http any any -> any any (msg:"ShopGuard login bruteforce"; flow:to_server; http.method; content:"POST"; http.uri; content:"/login"; threshold:type threshold, track by_src, count 10, seconds 30; classtype:attempted-user; sid:1000004; rev:1;)
